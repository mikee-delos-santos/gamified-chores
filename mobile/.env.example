# Base URL of the Rails backend. Copy to `.env` and adjust per environment.
# Expo inlines EXPO_PUBLIC_* variables at build time.
#
#   Android emulator → host machine:  http://10.0.2.2:3000
#   Physical device on same Wi-Fi:     http://<your-computer-LAN-ip>:3000
#   Deployed (Railway):                https://<your-app>.up.railway.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
